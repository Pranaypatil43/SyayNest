# Cloudinary Configuration (https://cloudinary.com)
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_api_key
CLOUD_API_SECRET=your_api_secret

# MongoDB Atlas Connection String
ATLASDB_URL=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Session Secret (generate a random string)
SECRET=your_super_secret_random_string_here

# Optional: MapTiler token for maps (https://maptiler.com)
MAP_TOKEN=your_maptiler_token
