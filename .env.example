# ── MongoDB Atlas ─────────────────────────────────────────
ATLASDB_URL=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# ── Session secret (use a long random string) ─────────────
SECRET=replace_with_a_long_random_secret_string

# ── Cloudinary (image uploads) ────────────────────────────
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_api_key
CLOUD_API_SECRET=your_api_secret

# ── Email OTP (Brevo SMTP — works on Render free tier) ────
# Gmail SMTP is blocked on Render. Use Brevo instead (free, 300 emails/day).
# Get credentials from: app.brevo.com/settings/keys/smtp
BREVO_USER=your_brevo_smtp_login
BREVO_PASS=your_brevo_smtp_key

# ── Google OAuth ─────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI (add BOTH for dev + prod):
#   http://localhost:8080/api/users/auth/google/callback
#   https://your-render-service.onrender.com/api/users/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Backend URL ───────────────────────────────────────────
# Used by app.js at runtime to build the Google OAuth callback URL.
# Dev:  http://localhost:8080
# Prod: https://your-render-service.onrender.com   ← set this on Render
BACKEND_URL=http://localhost:8080

# ── Vite API URL (frontend build-time) ────────────────────
# Used by Vite at BUILD TIME to embed the backend URL in the React bundle.
# Dev:  leave blank — Vite proxy handles /api calls to localhost:8080
# Prod: https://your-render-service.onrender.com   ← set this on Vercel
VITE_API_URL=

# ── CORS allowed origin (backend runtime) ─────────────────
# The Vercel frontend URL that the backend will allow cross-origin requests from.
# Leave blank if backend serves frontend from same domain (single-server deploy).
# Comma-separate multiple URLs for Vercel preview deployments:
#   CLIENT_URL=https://staynest.vercel.app,https://staynest-git-main-yourname.vercel.app
# Dev:  leave blank (localhost is whitelisted automatically)
# Prod: https://staynest.vercel.app   ← set this on Render
CLIENT_URL=

# ── Node environment ──────────────────────────────────────
# Set to "production" on both Render and Vercel
NODE_ENV=production

# ── Port ─────────────────────────────────────────────────
# Render sets PORT automatically — do NOT hardcode this on Render
PORT=8080
