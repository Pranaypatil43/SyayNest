# ── MongoDB Atlas ─────────────────────────────────────────
ATLASDB_URL=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# ── Session secret (use a long random string) ─────────────
SECRET=replace_with_a_long_random_secret_string

# ── Cloudinary (image uploads) ────────────────────────────
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_api_key
CLOUD_API_SECRET=your_api_secret

# ── Gmail OTP (nodemailer) ────────────────────────────────
# Use a Gmail App Password (NOT your real password)
# Get it: myaccount.google.com → Security → App passwords
GMAIL_USER=your_gmail@gmail.com
GMAIL_PASS=your_16_char_app_password

# ── Google OAuth ─────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:8080/api/users/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Backend URL (also used by Vite for Google OAuth button) ──
# Dev: http://localhost:8080
# Production: https://your-eb-url.ap-south-1.elasticbeanstalk.com
VITE_API_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080

# ── Production only ───────────────────────────────────────
NODE_ENV=production

# Your frontend domain (used for CORS on AWS)
# e.g. https://staynest.yourdomain.com  OR  https://your-ec2-ip
# If backend serves the frontend (single EC2 instance), leave blank
CLIENT_URL=

# Port (AWS Elastic Beanstalk sets this automatically)
PORT=8080
