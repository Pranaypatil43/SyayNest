<% layout("layouts/boilerplate") %>
<%=success%>
  
  <style>
    #filters {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
    }

    .filter {
      text-align: center;
      margin-right: 2.5rem;
      margin-top: 1rem;
      margin-bottom: 1rem;
      opacity: 0.7;
    }

    .filter:hover {
      opacity: 1.5;
      cursor: pointer;
    }

    .tax-info {
      display: none;
    }

    .txg-toggle {
      border: 1px solid black;
      border-radius: 1rem;
      height: 3rem;
      padding: 1rem;
      display: flex;
      align-items: center;
       margin-left: auto;
    }

    #filters a.filter {
  text-decoration: none;   /* remove underline */
  color: inherit;          /* keep original color */
  display: inline-block;   /* behave like div */
}

#filters a.filter:hover {
  color: inherit;          /* no blue on hover */
}

.filter.active {
  opacity: 1;
  border-bottom: 2px solid black;
  font-weight: 600;
}

  </style>


<div id="filters">

  <a
    href="/listings"
    data-category=""
    class="filter <%= !category ? 'active' : '' %>"
  >
    <i class="fa-solid fa-border-all"></i>
    <p>All</p>
  </a>

  <a
    href="/listings?category=trending"
    data-category="trending"
    class="filter <%= category === 'trending' ? 'active' : '' %>"
  >
    <i class="fa-solid fa-fire"></i>
    <p>Trending</p>
  </a>

  <a
    href="/listings?category=rooms"
    data-category="rooms"
    class="filter <%= category === 'rooms' ? 'active' : '' %>"
  >
    <i class="fa-solid fa-bed"></i>
    <p>Rooms</p>
  </a>

  <a
    href="/listings?category=iconic"
    data-category="iconic"
    class="filter <%= category === 'iconic' ? 'active' : '' %>"
  >
    <i class="fa-solid fa-city"></i>
    <p>Iconic Cities</p>
  </a>

  <a
    href="/listings?category=mountains"
    data-category="mountains"
    class="filter <%= category === 'mountains' ? 'active' : '' %>"
  >
    <i class="fa-solid fa-tree-city"></i>
    <p>Mountains</p>
  </a>

  <a
    href="/listings?category=beachfront"
    data-category="beachfront"
    class="filter <%= category === 'beachfront' ? 'active' : '' %>"
  >
    <i class="fa-solid fa-umbrella-beach"></i>
    <p>Beachfront</p>
  </a>

  <a
    href="/listings?category=pools"
    data-category="pools"
    class="filter <%= category === 'pools' ? 'active' : '' %>"
  >
    <i class="fa-solid fa-hot-tub-person"></i>
    <p>Amazing Pools</p>
  </a>

  <a
    href="/listings?category=farms"
    data-category="farms"
    class="filter <%= category === 'farms' ? 'active' : '' %>"
  >
    <i class="fa-solid fa-tractor"></i>
    <p>Farms</p>
  </a>

  <a
    href="/listings?category=arctic"
    data-category="arctic"
    class="filter <%= category === 'arctic' ? 'active' : '' %>"
  >
    <i class="fa-regular fa-snowflake"></i>
    <p>Arctic</p>
  </a>

  <a
    href="/listings?category=views"
    data-category="views"
    class="filter <%= category === 'views' ? 'active' : '' %>"
  >
    <i class="fa-solid fa-eye"></i>
    <p>Amazing Views</p>
  </a>

  <div class="txg-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault">
      <label class="form-check-label" for="flexSwitchCheckDefault">
        Display After Taxes
      </label>
    </div>
  </div>

</div>


  
   
   <div
  id="listings-container"
  class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1"
>

      <% for (let listing of allListings) { %>
        <a href="/listings/<%= listing._id %>"  class="listing-links">
          <div class="card col listing-card">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="listing image" style="height: 20rem;">
            <overlay class="overlay"></overlay> 
              <!-- <div class="text"><i class="fa-solid fa-heart"></i></div> -->
            <div class="card-body">
              <p class="card-text">
                <b>
                  <%= listing.title %>
                </b><br>
                &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
               <i class="tax-info"> &nbsp;+18% GST</i>
              </p>
            </div>
          </div>
          </a>
          <% } %>
    </div>
    

<script>
  const toggle = document.getElementById("flexSwitchCheckDefault");
  toggle.addEventListener("change", () => {
    let taxinfo = document.getElementsByClassName("tax-info");
  for(info of taxinfo){
    if(info.style.display != "inline"){
      info.style.display = "inline";
    } else {
      info.style.display = "none";  
    }
  }
    });
  
</script>
<script>
  const filterLinks = document.querySelectorAll("#filters .filter");
  const listingsContainer = document.getElementById("listings-container");

  filterLinks.forEach(link => {
    link.addEventListener("click", async (e) => {
      e.preventDefault(); // stop page reload

      const category = link.dataset.category;

      try {
        const res = await fetch(`/listings/api/filter?category=${category}`);
        const listings = await res.json();

        // clear old listings
        listingsContainer.innerHTML = "";

        // render new listings
        listings.forEach(listing => {
          listingsContainer.innerHTML += `
            <a href="/listings/${listing._id}" class="listing-links">
              <div class="card col listing-card">
                <img
                  src="${listing.image.url}"
                  class="card-img-top"
                  style="height: 20rem;"
                >
                <div class="card-body">
                  <p class="card-text">
                    <b>${listing.title}</b><br>
                    ₹${Number(listing.price).toLocaleString("en-IN")}/night
                     <i class="tax-info" style="display:${toggle.checked ? 'inline' : 'none'}">
                    &nbsp;+18% GST
                  </i>
                  </p>
                </div>
              </div>
            </a>
          `;
        });
      } catch (err) {
        console.error("Filter error:", err);
      }
    });
  });
</script>



  