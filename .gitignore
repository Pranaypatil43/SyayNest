# ── Environment variables (never commit secrets) ──
# Only ONE .env file at root — client reads from it via vite.config.js
.env
.env.*
!.env.example

# ── Dependencies ──
node_modules/
client/node_modules/

# ── Build output ──
client/dist/

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-error.log*

# ── OS files ──
.DS_Store
Thumbs.db

# ── Editor ──
.vscode/*
!.vscode/extensions.json
.idea/
